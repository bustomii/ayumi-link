# Ayumi Link configuration. Copy to `.env` and edit:   cp .env.example .env
# Real environment variables always win over this file. Every setting is optional.
#
# Used by: `docker compose` (substitution + container env) AND the backend itself when it
# runs directly (it reads ./.env, or the file named in AYUMI_ENV_FILE).

# ----------------------------------------------------------------------------
# Access control
# ----------------------------------------------------------------------------

# Only these client addresses may reach the app at all (login page included).
# Comma-separated IPs and/or CIDR ranges. Empty = everyone who can reach the port.
# Remember to include your own address, e.g. 127.0.0.1 and ::1 for local access.
#   AYUMI_ALLOWED_IPS=203.0.113.7, 192.168.1.0/24, 100.64.0.0/10, 127.0.0.1, ::1
# NOTE (Docker): inside a container the client IP is often the Docker gateway, so prefer
# restricting at the published port (AYUMI_BIND) or behind a proxy (see below).
AYUMI_ALLOWED_IPS=

# Only these host names (domains) may be used to reach the app; any other Host header gets 403.
# Comma-separated, no scheme/port. Supports one-level wildcards ("*.example.com"). Empty = any host.
# Protects against DNS-rebinding and access through domains you did not intend.
# Keep localhost/127.0.0.1 in the list if you also open the app locally (and for the Docker healthcheck).
#   AYUMI_ALLOWED_HOSTS=link.example.com, localhost, 127.0.0.1
AYUMI_ALLOWED_HOSTS=

# Origins besides same-origin that may call the API (comma-separated, e.g. a custom domain).
# Needed when a proxy rewrites the Host header (then the browser's Origin no longer matches it).
#   ALLOWED_ORIGINS=https://link.example.com
ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Behind a reverse proxy / tunnel (Cloudflare Tunnel, nginx, Caddy, Tailscale Funnel...)
# ----------------------------------------------------------------------------

# Trust the proxy's client-IP header and X-Forwarded-Proto. Required for AYUMI_ALLOWED_IPS to
# see the real visitor behind a proxy. Only enable when the app is NOT directly reachable.
AYUMI_TRUST_PROXY=false
# Header that carries the real client IP. Use one your proxy SETS (overwrites), not appends:
# CF-Connecting-IP (Cloudflare), X-Real-IP (nginx), X-Forwarded-For (generic).
AYUMI_PROXY_HEADER=X-Forwarded-For
# Only these proxy addresses are believed (IPs/CIDRs). Strongly recommended with TRUST_PROXY.
AYUMI_TRUSTED_PROXIES=
# Mark the session cookie Secure. Set to true whenever you serve over HTTPS.
AYUMI_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Direct run: address to listen on. Loopback keeps it private. (Docker sets 0.0.0.0 itself.)
HOST=127.0.0.1
PORT=8081

# Max requests per minute per IP on login/auth endpoints.
AYUMI_AUTH_RATE_LIMIT=10

# Where account/2FA/state is stored (direct run). Default: your OS config dir / ayumi-link.
# AYUMI_DATA_DIR=

# Folders that can be chosen for new sessions (":"-separated). Direct-run default: your home
# directory. In Docker this must be a path that exists *inside* the container (see WORKSPACE_*).
# AYUMI_ROOTS=/Users/me/Public/Working

# Chat attachments (images, PDF, Excel .xlsx/.csv, Word .docx; everything else is rejected).
# Max size per file in MB, max total stored in MB, and days before old attachments are deleted.
AYUMI_MAX_UPLOAD_MB=20
AYUMI_UPLOAD_MAX_TOTAL_MB=2048
AYUMI_UPLOAD_TTL_DAYS=30

# Browser tab: headless Chromium on the server (login cookies are kept in the data dir).
# Auto-detected (Docker image ships Chromium). Override the binary, set how many minutes of
# inactivity before it is shut down to save memory, or switch the feature off.
# Native: auto-detect Chrome/Chromium/Edge; dedicated profile at <AYUMI_DATA_DIR>/browser-profile
# AYUMI_BROWSER_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
AYUMI_BROWSER_IDLE_MIN=10
AYUMI_BROWSER_DISABLED=false

# Default tool-permission mode: auto | acceptEdits | manual | plan
AYUMI_PERMISSION_MODE=auto

# Path of the `claude` CLI. Default: newest one bundled with Claude Desktop, else `claude` in PATH.
# CLAUDE_BIN=

# Where Claude stores sessions (default ~/.claude) and Claude Desktop's data folder
# (only used to mirror Desktop folder groups; macOS default).
# CLAUDE_HOME=
# CLAUDE_DESKTOP_DIR=

# ----------------------------------------------------------------------------
# Docker only
# ----------------------------------------------------------------------------

# Interface/port published on the host. Keep 127.0.0.1 unless you know what you are doing.
AYUMI_BIND=127.0.0.1
AYUMI_PORT=8081

# Host project folder for "Buat session baru". Prefer the same absolute path in the container
# so Desktop session cwds still resolve:
#   WORKSPACE_DIR=/Users/me/Public/Working
#   WORKSPACE_MOUNT=/Users/me/Public/Working
#   AYUMI_ROOTS=/Users/me/Public/Working
# Default (empty local dir):
WORKSPACE_DIR=./workspace
WORKSPACE_MOUNT=/workspace

# Extra apt packages installed in the image for the Terminal tab / Claude (space-separated), e.g.
#   EXTRA_APT_PACKAGES=jq curl python3 make
# Host docker access (docker / docker compose from the Terminal): see docker-compose.host-docker.yml.
# DOCKER_SOCK=/var/run/docker.sock
# DOCKER_GID=0
# (both are filled in automatically by: make up-docker)

# Pin the Claude Code CLI version baked into the image (default: latest at build time).
# CLAUDE_CODE_VERSION=2.1.325

# Use your host's Claude sessions inside the container (absolute path, bind mount). Default: empty private volume.
# CLAUDE_HOME_DIR=/Users/me/.claude
# Host Claude auth file (~/.claude.json). Required for chat without re-login in the container.
# CLAUDE_CONFIG_JSON=/Users/me/.claude.json

# Host Claude Desktop data folder so sidebar groups match Desktop (JABAR, VelocInfra, …).
# Mount 1:1 (same path) so scratch-workspace cwds resolve inside the container:
# CLAUDE_DESKTOP_HOST_DIR=/Users/me/Library/Application Support/Claude
# CLAUDE_DESKTOP_DIR=/Users/me/Library/Application Support/Claude

# Claude authentication inside the container. Prefer UI:
#   Profil & keamanan → Claude CLI → tempel token dari `claude setup-token` (disimpan di volume /data).
# Alternatif env (opsional):
#  1) Interactive:  docker compose exec -it ayumi-link claude auth login
#  2) Subscription token:
# CLAUDE_CODE_OAUTH_TOKEN=
#  3) API key (billed per token):
# ANTHROPIC_API_KEY=
